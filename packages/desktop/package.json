{
  "name": "@openjarvis/desktop",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/electron-main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "dev": "concurrently --kill-others \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:electron": "electron .",
    "dev:renderer": "vite --config vite.renderer.config.ts --port 5173",
    "start": "electron .",
    "pack": "npm run build && npm run build:renderer && electron-builder"
  },
  "dependencies": {
    "@openjarvis/core": "*",
    "@openjarvis/jarvis": "*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "electron": "^30.0.0",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  },
  "peerDependencies": {
    "electron": ">=30.0.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  }
}
